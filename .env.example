# Copiar a apps/web/.env.local y completar con las claves del proyecto.
# El dashboard las muestra en Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave publicable (antes "anon"). Viaja al navegador: es pública por diseño y
# lo único que la contiene es RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Clave secreta (antes "service_role"). Salta RLS por completo.
# Sólo en el servidor. Nunca con prefijo NEXT_PUBLIC_, nunca en un commit.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contraseña compartida por las cuentas de demostración que crea
# `pnpm db:seed`. Va sólo en .env.local (raíz del repo), nunca en git: el
# repositorio es público y el sitio desplegado usa la misma base.
BODGO_DEMO_PASSWORD=
