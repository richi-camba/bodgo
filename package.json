{
  "name": "bodgo",
  "private": true,
  "version": "0.1.0",
  "description": "BodGo — red de microbodegas urbanas para el e-commerce de las PyMEs",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @bodgo/web dev",
    "build": "pnpm --filter @bodgo/web build",
    "start": "pnpm --filter @bodgo/web start",
    "lint": "pnpm --filter @bodgo/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @bodgo/core test",
    "db:types": "supabase gen types typescript --linked > packages/db/src/database.types.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  }
}
